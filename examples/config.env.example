# Copy to ~/.config/autocoding/config.env and edit as needed.
# Every value is optional — defaults from lib/config.sh apply otherwise.

# Where to clone repos into. Default: $HOME/Projekte
# REPOS_DIR="$HOME/Projekte"

# Default base branch for PRs. Default: main
# BASE_BRANCH="main"

# Maximum review loops before opening the PR anyway. Default: 3
# MAX_REVIEWS=3

# Watch-mode polling interval. Accepts 30s, 5m, 1h. Default: 15m
# WATCH_INTERVAL="15m"

# Claude model to use. Default: opus
# CLAUDE_MODEL="opus"

# Retry count for failing Claude sessions. Default: 3
# CLAUDE_RETRIES=3

# Base backoff seconds (exponential: 5, 15, 45). Default: 5
# CLAUDE_BACKOFF_BASE=5

# Optional dollar budget per Claude call (passes --max-budget-usd). Default: unset
# CLAUDE_MAX_BUDGET_USD=2.00
