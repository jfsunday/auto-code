# Copy to ~/.config/autocoding/config.env and edit as needed.
# Every value is optional — defaults from lib/config.sh apply otherwise.

# Where to clone repos into. Default: $HOME/Projekte
# REPOS_DIR="$HOME/Projekte"

# Default base branch for PRs. Default: main
# BASE_BRANCH="main"

# Maximum review loops before opening the PR anyway. Default: 3
# MAX_REVIEWS=3

# Watch-mode polling interval. Accepts 30s, 5m, 1h. Default: 15m
# WATCH_INTERVAL="15m"

# Claude model to use. Default: opus
# CLAUDE_MODEL="opus"

# Retry count for failing Claude sessions. Default: 3
# CLAUDE_RETRIES=3

# Base backoff seconds (exponential: 5, 15, 45). Default: 5
# CLAUDE_BACKOFF_BASE=5

# Optional dollar budget per Claude call (passes --max-budget-usd). Default: unset
# CLAUDE_MAX_BUDGET_USD=2.00

# Who gets a review request on PRs that are not auto-merged (or whose merge
# failed): owner (repo owner; skipped for orgs) | <github-login> | none.
# Per-repo override: --reviewer WHO / --no-reviewer (persisted). Default: owner
# DEFAULT_REVIEWER=owner

# --- Bot identity (optional) ---
# If set, all gh/git operations the script does are done AS THIS GitHub user.
# Your interactive shell keeps whatever gh account you had active; only the
# script's calls are re-authed. Requires that user to be logged in via
# `gh auth login` (adds them as a second account — see README).
# AUTOCODING_GH_USER="accoding9173"
# AUTOCODING_GIT_NAME="accoding9173"
# AUTOCODING_GIT_EMAIL="accoding9173@users.noreply.github.com"
